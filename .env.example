# Build-time environment for Fall Line. Copy to `.env` (git-ignored) if you
# want to override defaults locally. Everything is optional — the app builds
# and runs with none of these set. See docs/configuration.md.

# Deploy base path (set by the Pages workflow per slot). Local default: /
# VITE_BASE=/

# Sibling deploy slots the root service worker must disown (root slot only).
# VITE_PWA_IGNORE_PATHS=/preview/,/branch/

# A Chromium for the browser-driven tools (`make screenshots`, `make profile`).
# Claude web sessions have one preinstalled at this path.
# CHROMIUM_PATH=/opt/pw-browsers/chromium

# The skis are drawn from the MODELS committed in pwa/models/ (`make
# models`); 0 switches them back to the code-built. (The skier — dressed
# in his outfit — the trees, the wildlife and the course's marks are always
# built in code.) CI reads the repository variable of the same name (`make
# ci-models MODELS=off`). See docs/configuration.md.
# VITE_MODEL_SKIS=0
# The helicopter's model (pwa/models/heli.glb); 0 packs none and the free
# ride draws the code's stand-in.
# VITE_MODEL_HELI=0
