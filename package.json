    "birds": "node scripts/birds-preview.mjs",
    "crowd": "node scripts/crowd-preview.mjs",
    "audience": "node scripts/audience-preview.mjs",
    "civilians": "node scripts/civilians-preview.mjs",
    "lift-ride": "node scripts/lift-ride-preview.mjs",
    "lift-flow": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/lift-flow-lab.mjs",
    "lift-path": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/lift-path-lab.mjs",
    "heli": "node scripts/heli-preview.mjs",
    "sled": "node scripts/sled-preview.mjs",
    "sled-land": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sled-land-lab.mjs",
    "sled-turn": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sled-turn-lab.mjs",
    "para": "node scripts/para-preview.mjs",
    "para-wind": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/para-wind-lab.mjs",
    "balloon": "node scripts/balloon-preview.mjs",
    "balloon-flight": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/balloon-lab.mjs",
    "grimbear": "node scripts/grimbear-preview.mjs",
