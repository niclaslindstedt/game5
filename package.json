    "gore": "node scripts/gore-preview.mjs",
    "replay-cam": "node scripts/replaycam-preview.mjs",
    "xray": "node scripts/xray-preview.mjs",
    "xray-body": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/xray-body.mjs",
    "groomer": "node scripts/groomer-preview.mjs",
    "snowguns": "node scripts/snowguns-preview.mjs",
    "tree-wells": "node scripts/tree-wells-preview.mjs",
    "trails": "node scripts/trails-preview.mjs",
    "piste-day": "node scripts/piste-day-preview.mjs",
    "judder": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/judder-lab.mjs",
    "trees": "node scripts/trees-preview.mjs",
    "cabins": "node scripts/cabins-preview.mjs",
    "afterski": "node scripts/afterski-preview.mjs",
    "forest": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/forest-lab.mjs",
    "tauri": "npm --prefix tauri run start --",
    "tauri:bundle": "npm --prefix tauri run bundle",
    "tauri:test": "npm --prefix tauri test",
    "tauri:lint": "npm --prefix tauri run lint",
    "tauri:fmt": "npm --prefix tauri run fmt",
    "tauri:install": "npm --prefix tauri install",
    "tauri:package": "npm run tauri:install && npm --prefix tauri run package --",
    "native": "npm --prefix native start",
    "native:install": "npm --prefix native install",
    "native:bundle": "npm --prefix native run bundle",
    "native:typecheck": "npm --prefix native run typecheck",
    "native:ios": "npm --prefix native run ios",
    "native:ios:device": "npm --prefix native run ios:device",
    "native:android": "npm --prefix native run android",
    "town": "node scripts/town-preview.mjs"
  },
  "dependencies": {
    "@niclaslindstedt/oss-game-framework": "github:niclaslindstedt/oss-game-framework#v0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
