{
  "name": "game5",
  "version": "0.1.0",
  "private": true,
  "description": "Fall Line — a downhill skiing game for the browser: a generated mountain with a graded piste down it, forests and powder either side, playable on phone and desktop as an installable PWA.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Niclas Lindstedt",
  "type": "module",
  "workspaces": [
    "pwa"
  ],
  "scripts": {
    "dev": "npm run dev --workspace pwa",
    "build": "npm run typecheck:only && npm run build --workspace pwa",
    "preview": "npm run preview --workspace pwa",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:only",
    "typecheck:only": "tsc --noEmit && npm run typecheck --workspace pwa",
    "lint": "eslint . && npm run typecheck:only",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "sim": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/simulate-run.mjs",
    "level": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/level-map.mjs",
    "analyze": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/analyze-level.mjs",
    "rate": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/rate-level.mjs",
    "difficulty": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/difficulty-preview.mjs",
    "routes": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/campaign-routes.mjs",
    "model-registry": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/model-registry.mjs",
    "ride": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/ride-lab.mjs",
    "audition": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/audition.mjs",
    "screenshots": "node scripts/screenshot.mjs",
    "profile": "node scripts/profile-render.mjs",
    "bench": "node scripts/benchmark.mjs",
    "world": "node scripts/world-preview.mjs",
    "skis": "node scripts/skis-preview.mjs",
    "blender": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/blender.mjs",
    "sky": "node scripts/sky-preview.mjs",
    "cloud": "node scripts/cloud-preview.mjs",
    "birds": "node scripts/birds-preview.mjs",
    "trees": "node scripts/trees-preview.mjs",
    "forest": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/forest-lab.mjs",
    "tauri": "npm --prefix tauri run start --",
    "tauri:bundle": "npm --prefix tauri run bundle",
    "tauri:test": "npm --prefix tauri test",
    "tauri:lint": "npm --prefix tauri run lint",
    "tauri:fmt": "npm --prefix tauri run fmt",
    "tauri:install": "npm --prefix tauri install",
    "tauri:package": "npm run tauri:install && npm --prefix tauri run package --",
    "native": "npm --prefix native start",
    "native:install": "npm --prefix native install",
    "native:bundle": "npm --prefix native run bundle",
    "native:typecheck": "npm --prefix native run typecheck",
    "native:ios": "npm --prefix native run ios",
    "native:ios:device": "npm --prefix native run ios:device",
    "native:android": "npm --prefix native run android"
  },
  "dependencies": {
    "@niclaslindstedt/oss-game-framework": "github:niclaslindstedt/oss-game-framework#v0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
