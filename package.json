{
  "name": "game5",
  "version": "0.1.0",
  "private": true,
  "description": "Fall Line — a downhill skiing game for the browser: a generated mountain with a graded piste down it, forests and powder either side, playable on phone and desktop as an installable PWA.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Niclas Lindstedt",
  "type": "module",
  "workspaces": [
    "pwa"
  ],
  "scripts": {
    "dev": "npm run dev --workspace pwa",
    "build": "npm run typecheck:only && npm run build --workspace pwa",
    "preview": "npm run preview --workspace pwa",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:only",
    "typecheck:only": "tsc --noEmit && npm run typecheck --workspace pwa",
    "lint": "eslint . && npm run typecheck:only",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "sim": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/simulate-run.mjs",
    "resort": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/resort-map.mjs",
    "lift-tops": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/lift-tops.mjs",
    "junctions": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/junctions-lab.mjs",
    "level": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/level-map.mjs",
    "analyze": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/analyze-level.mjs",
    "rate": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/rate-level.mjs",
    "difficulty": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/difficulty-preview.mjs",
    "routes": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/map-routes.mjs",
    "real-faces": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/real-faces.mjs",
    "model-registry": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/model-registry.mjs",
    "ride": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/ride-lab.mjs",
    "audition": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/audition.mjs",
    "screenshots": "node scripts/screenshot.mjs",
    "title": "node scripts/title-preview.mjs",
    "profile": "node scripts/profile-render.mjs",
    "bench": "node scripts/benchmark.mjs",
    "cpu-cost": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/cpu-cost.mjs",
    "world": "node scripts/world-preview.mjs",
    "skis": "node scripts/skis-preview.mjs",
    "helmet": "node scripts/helmet-preview.mjs",
    "damage": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/damage-preview.mjs",
    "hud-body": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/hud-body.mjs",
    "gear": "node scripts/gear-preview.mjs",
    "skier": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/skier-preview.mjs",
    "skier-metrics": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/skier-metrics.mjs",
    "sag": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sag-lab.mjs",
    "landing": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/landing-lab.mjs",
    "injuries": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/injury-lab.mjs",
    "lean": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/lean-lab.mjs",
    "poleless": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/poleless-lab.mjs",
    "skate-turns": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/skate-turns-lab.mjs",
    "sidestep": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sidestep-lab.mjs",
    "blender": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/blender.mjs",
    "sky": "node scripts/sky-preview.mjs",
    "cloud": "node scripts/cloud-preview.mjs",
    "snowfall": "node scripts/snowfall-preview.mjs",
    "turns": "node scripts/turns-preview.mjs",
